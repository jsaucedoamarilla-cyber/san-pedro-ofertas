rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'active';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.featured == false
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 90
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1200;
      allow update: if isAdmin()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.get('views', 0) + 1)
        || (activeUser() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.featured == resource.data.featured);
      allow delete: if isAdmin();

      match /comments/{commentId} {
        function parentIsApproved() {
          return get(/databases/$(database)/documents/listings/$(listingId)).data.status == 'approved';
        }
        allow read: if parentIsApproved() || isAdmin();
        allow create: if activeUser() && parentIsApproved()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'visible'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if isAdmin();
        allow delete: if isAdmin() || (activeUser() && resource.data.uid == request.auth.uid);
      }
    }

    match /wantedRequests/{requestId} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 1000
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() <= 30;
      allow update, delete: if isAdmin();
      match /replies/{replyId} {
        function parentIsApproved() {
          return get(/databases/$(database)/documents/wantedRequests/$(requestId)).data.status == 'approved';
        }
        allow read: if parentIsApproved() || isAdmin();
        allow create: if activeUser() && parentIsApproved()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'visible'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 600
          && request.resource.data.photo is string;
        allow update: if isAdmin();
        allow delete: if isAdmin() || (activeUser() && resource.data.uid == request.auth.uid);
      }
    }
    match /anonymousVisitors/{visitorId} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['firstSeen', 'lastSeen', 'converted'])
        && request.resource.data.firstSeen == request.time
        && request.resource.data.lastSeen == request.time
        && request.resource.data.converted == false;
      allow update: if (request.auth == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
          && request.resource.data.lastSeen == request.time)
        || (activeUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['converted', 'lastSeen'])
          && request.resource.data.converted == true
          && request.resource.data.lastSeen == request.time);
      allow read, delete: if isAdmin();
    }

    match /listingReports/{reportId} {
      allow create: if activeUser() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.listingId is string;
      allow read, update, delete: if isAdmin();
    }

    match /featuredRequests/{requestId} {
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.duration in [5, 10, 20, 30]
        && request.resource.data.amount == (request.resource.data.duration * 1000)
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'approved';
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }
    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin()) && validImage(5 * 1024 * 1024);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /listings/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin()) && validImage(8 * 1024 * 1024);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /receipts/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
  }
}
